# FinSight AI Backend Configuration
APP_NAME=FinSight AI
APP_ENV=development
SECRET_KEY=generate-a-unique-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./finsight.db

# File Upload Limits
MAX_UPLOAD_SIZE_MB=25
UPLOAD_DIR=./uploads

# Production persistence (required on Vercel)
# DATABASE_URL=postgresql://user:password@host:6543/postgres?sslmode=require
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=your-server-only-secret-key
# Legacy deployments can continue to use SUPABASE_SERVICE_ROLE_KEY.
# SUPABASE_STORAGE_BUCKET=finsight-private

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI / LLM Configuration (Optional - configure one provider for AI chat & narrative insights)
# Supported providers: openai, gemini, openai_compatible
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

# OCR Configuration (Optional - path to tesseract executable if not on PATH)
TESSERACT_CMD=
